+	async createSignedAttachment(agentContext, data, options, issuerSupportedAlgs) {
+		const { alg, kid } = options;
+		if (!kid.startsWith("did:")) throw new CredoError(`kid '${kid}' is not a DID. Only dids are supported for kid`);
