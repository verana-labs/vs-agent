# Copy to .env and adjust. Used by docker-compose.demo.yml.

# Throwaway local-devnet keys, one per agent. All three must be distinct from each other and from
# the cooluser mnemonic in docker/verana-node-init.sh that the seed signs with. The seed funds the
# validator and the applicant; the ecosystem agent signs nothing on chain and stays unfunded, which
# is what makes its own ECS bootstrap skip.
VALIDATOR_MNEMONIC="recall buyer young reopen napkin will office warm chronic witness rigid wood"
APPLICANT_MNEMONIC="oblige wild human tomato announce method slim buzz maid seat chunk raven"
ECOSYSTEM_MNEMONIC="agree disagree sea wedding client volcano oxygen crack network occur walk miracle"

# The corporation each agent operates for. A fresh chain produces these ids; the seed prints them.
VALIDATOR_CORPORATION_ID=1
ECOSYSTEM_CORPORATION_ID=2
APPLICANT_CORPORATION_ID=3

# The ECS ecosystems the agents trust (WL-ECS), comma-separated. Replace with the `ecosystemDid`
# the seed prints: it is agent-ecosystem's own did:webvh and changes on every fresh volume. The
# placeholder only lets the agents boot, since a standalone agent refuses to start without it.
TRUSTED_ECS_ECOSYSTEM_DIDS=did:example:replace-with-the-seeded-ecosystemDid

# Optional image overrides.
#VERANA_NODE_IMAGE=veranalabs/verana-node:v0.10.1
#VERANA_INDEXER_IMAGE=veranalabs/verana-indexer:dev
