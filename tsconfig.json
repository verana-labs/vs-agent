{
  "extends": "./tsconfig.build.json",
  "ts-node": {
    "require": ["tsconfig-paths/register"],
    "files": true
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "paths": {
      "@verana-labs/*": ["./packages/*/src"],
      "@credo-ts/anoncreds/didcomm": ["./node_modules/@credo-ts/anoncreds/build/didcomm/index.d.mts"],
      "@credo-ts/webvh/anoncreds": ["./node_modules/@credo-ts/webvh/build/anoncreds/index.d.mts"]
    },
    "types": ["vitest", "node"]
  },
  "exclude": [
    "node_modules",
    "build",
    "examples",
    "apps/vs-agent-ui",
    "vitest.config.ts",
    "vitest.globalSetup.ts"
  ]
}
